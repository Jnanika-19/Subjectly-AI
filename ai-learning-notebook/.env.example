AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
# For Groq instead, set AI_PROVIDER=groq and configure GROQ_API_KEY and GROQ_MODEL.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Local single-account sign-in. Generate the password hash with:
# python -m app.services.auth_service
SUBJECTLY_LOGIN_EMAIL=student@example.com
SUBJECTLY_LOGIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUBJECTLY_SESSION_SECRET=
SUBJECTLY_SESSION_COOKIE_SECURE=false
EMBEDDING_PROVIDER=hf
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
